# Site
NEXT_PUBLIC_SITE_URL=https://kokende.vercel.app

# Clerk SSO — Google + Apple only (disable email/password in Clerk dashboard)
# Without these keys, the app ships with SSO UI + setup guidance (no email-password path).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in

# Optional Clerk URLs after auth
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app
